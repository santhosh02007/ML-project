# ==============================================================================
# Fake Job Posting & Recruitment Scam Detector - Environment Configuration
# ==============================================================================

PROJECT_NAME="Fake Job Posting & Recruitment Scam Detector"
VERSION="2.0.0"
API_V1_STR="/api"

# Database Configuration (SQLite by default, or PostgreSQL: postgresql://user:pass@localhost:5432/fake_jobs)
DATABASE_URL="sqlite:///./app.db"

# Risk Thresholds
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=60

# Security & Upload Limits
MAX_CSV_UPLOAD_SIZE_MB=15
MAX_BATCH_ROWS=5000
RATE_LIMIT_PER_MINUTE=120
ADMIN_API_KEY="admin-secret-key-change-in-prod"

# External Threat Intelligence APIs (Optional with local fallback heuristics)
VIRUSTOTAL_API_KEY=""
GOOGLE_SAFE_BROWSING_KEY=""
